<mxfile host="app.diagrams.net"><diagram name="Adatmodell – tantárgyak és beadandók"><mxGraphModel page="1" pageWidth="1400" pageHeight="700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Adatmodell – tantárgyak és beadandók" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=28;" vertex="1" parent="1"><mxGeometry x="30" y="25" width="1340" height="55" as="geometry"/></mxCell><mxCell id="3" value="Tantargy&#xa;────────────────&#xa;PK  id: long&#xa;     nev: szöveg (1–100)&#xa;&#xa;Minden mező kötelező." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fillColor=#eef4fb;strokeColor=#345575;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="440" height="280" as="geometry"/></mxCell><mxCell id="4" value="Beadando&#xa;────────────────&#xa;PK  id: long&#xa;     cim: szöveg (1–150)&#xa;FK  tantargy_id: long&#xa;     hatarido: dátum&#xa;     kesz: boolean = false&#xa;&#xa;Minden mező kötelező." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;fillColor=#eef4fb;strokeColor=#345575;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="850" y="160" width="480" height="370" as="geometry"/></mxCell><mxCell id="5" value="1                           0..*" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry x="535" y="240" width="290" height="50" as="geometry"/></mxCell><mxCell id="6" value="Egy beadandó: egy tantárgy.&#xa;Egy tantárgy: több beadandó." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry x="530" y="330" width="300" height="85" as="geometry"/></mxCell><mxCell id="7" value="PK = elsődleges kulcs; FK = idegen kulcs. A tantargy_id a Tantargy.id mezőre hivatkozik.&#xa;Logikai modell: a tárolási technológia a megvalósításkor választható ki." style="text;html